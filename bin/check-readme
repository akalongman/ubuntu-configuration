#!/usr/bin/env python3
"""Check that README.md's table of contents mirrors its headings and its local links resolve.

Prints one line per problem, sorted by line, as `<path>:<line>: <message>`, or
as a GitHub annotation when GITHUB_ACTIONS=true. Exit status: 0 when clean,
1 on problems, 2 when the file cannot be read or has no '# Table of Contents'
section.
"""

import argparse
import difflib
import os
import re
import sys
from collections.abc import Iterator
from pathlib import Path
from typing import NamedTuple
from urllib.parse import unquote

# The docstring's first line, kept apart because `python3 -OO` drops docstrings.
DESCRIPTION = (
    "Check that README.md's table of contents mirrors its headings and its local links resolve."
)
HEADING = re.compile(r'^ {0,3}(#{1,6})[ \t]+(.*?)(?:[ \t]+#+)?[ \t]*$')
FENCE_OPEN = re.compile(r'^ {0,3}(`{3,}|~{3,})')
FENCE_CLOSE = re.compile(r'^ {0,3}(`{3,}|~{3,})[ \t]*$')
INDENTED = re.compile(r'( {4}|\t)')
LIST_ITEM = re.compile(r'^\s*([-*+]|\d+[.)])\s')
QUOTE = re.compile(r'^ {0,3}>')
# The underline that makes the paragraph line above it a setext heading: `=` for H1, `-` for H2.
SETEXT = re.compile(r'^ {0,3}(=+|-+)[ \t]*$')
# An ATX heading inside a blockquote or a list item, which GitHub renders as a heading.
NESTED_HEADING = re.compile(r'^ {0,3}(>\s*)+#{1,6}\s|^\s*([-*+]|\d+[.)])\s+#{1,6}\s')
# Markup that changes the rendered heading text, so the anchor rule below does not model it:
# inline and full reference links, entity references, HTML tags and `_` emphasis. An
# intraword `_` (mod_rewrite) is literal; backticks and `*` are dropped by the anchor rule,
# as on GitHub.
MARKUP = re.compile(
    r'\[[^\]]*\]\(|\[[^\]]*\]\[|&[A-Za-z#][A-Za-z0-9]*;|<[A-Za-z/!]|(?<!\w)_|_(?!\w)'
)
# A `[label](target)` link, a `- [label](target)` TOC item, and a TOC line a reader means
# as an item: a list item with any bullet, or a line starting with a tab.
ITEM_LINK = re.compile(r'\[[^\]]*\]\(([^)\s]+)\)')
TOC_ITEM = re.compile(r'- ' + ITEM_LINK.pattern)
TOC_LIKE = re.compile(r'\s*[-*+]\s|\t')
TOC_TITLE = 'Table of Contents'
UNPARSABLE = "TOC line is not a '- [label](#anchor)' item; use '- ' bullets and space indentation"
# The target of a link or image, up to the `)` or the space before a title.
LINK = re.compile(r'\]\(([^)\s]+)')
# A link reference definition, `[label]: target`, at the start of a line.
REFERENCE = re.compile(r'^ {0,3}\[[^\]]+\]:\s*<?([^\s>]+)>?')
# An HTML `href` or `src` attribute, double or single quoted; group 2 is the target.
ATTRIBUTE = re.compile(r'(?<![\w-])(?:href|src)\s*=\s*(["\'])(.*?)\1', re.IGNORECASE)
BACKTICKS = re.compile(r'`+')
# A target with a URI scheme (`https:`, `mailto:`, `ftp:`, `tel:`) is external.
SCHEME = re.compile(r'^[A-Za-z][A-Za-z0-9+.-]*:')
# Relative links into another release branch, which GitHub resolves under the current branch.
BRANCH_LINK = ('tree/', 'blob/')
REPO_URL = 'https://github.com/akalongman/ubuntu-configuration/'


class Heading(NamedTuple):
    line: int  # 1-based
    level: int
    text: str
    anchor: str


class TocLine(NamedTuple):
    line: int  # 1-based
    indent: int | None  # spaces before the first item; None when the line is unparsable
    items: list[re.Match[str]]  # every item on the line, in order; group 1 is its target


class TocEntry(NamedTuple):
    line: int  # 1-based
    indent: int | None  # None when not checked: a later item on its line, or unparsable
    slug: str  # the target without its `#`


def anchor(text: str) -> str:
    """GitHub's anchor for plain heading text, before duplicate suffixes."""
    return re.sub(r'[^\w\- ]', '', text.lower()).replace(' ', '-')


def fenced(lines: list[str]) -> Iterator[tuple[int, str, bool]]:
    """Yield (0-based index, line, True for fenced code and its fences) for every line."""
    fence = None
    for index, line in enumerate(lines):
        if fence:
            close = FENCE_CLOSE.match(line)
            if close and close[1][0] == fence[0] and len(close[1]) >= len(fence):
                fence = None
            yield index, line, True
        else:
            opening = FENCE_OPEN.match(line)
            fence = opening[1] if opening else None
            yield index, line, fence is not None


def outside_fences(lines: list[str]) -> Iterator[tuple[int, str]]:
    """Yield (0-based index, line) for every line outside fenced code."""
    for index, line, in_fence in fenced(lines):
        if not in_fence:
            yield index, line


def outside_code(lines: list[str]) -> Iterator[tuple[int, str]]:
    """Yield (0-based index, line) for every line outside fenced and indented code.

    A line indented 4 spaces or a tab opens an indented code block when the line before it
    is blank and it is not inside a list. The block runs over blank and indented lines and
    ends at the first non-blank line indented less. A list item line enters a list; a
    heading, a fence, or an unindented line after a blank line leaves it.
    """
    in_list = in_code = False
    after_blank = True  # the start of the file counts as a blank line
    for index, line, in_fence in fenced(lines):
        blank = not line.strip()
        indented = INDENTED.match(line) is not None
        if in_fence:
            in_list = in_code = False
        else:
            if in_code or (indented and after_blank and not in_list):
                in_code = blank or indented
            if not in_code:
                if LIST_ITEM.match(line):
                    in_list = True
                elif HEADING.match(line) or (after_blank and not blank and not line[0].isspace()):
                    in_list = False
                yield index, line
        after_blank = blank


def is_paragraph(line: str) -> bool:
    """True for a plain paragraph line: not blank, a list item, a heading, a quote, indented,
    or itself a setext underline."""
    return bool(line.strip()) and not any(
        pattern.match(line) for pattern in (LIST_ITEM, HEADING, QUOTE, INDENTED, SETEXT)
    )


def parse_headings(lines: list[str]) -> list[Heading]:
    """Every ATX and setext heading outside fenced code, with GitHub's `-1`, `-2` suffixes on
    repeats."""
    headings = []
    taken = {}
    for index, line in outside_fences(lines):
        match = HEADING.match(line)
        below = SETEXT.match(lines[index + 1]) if index + 1 < len(lines) else None
        if match:
            level, text = len(match[1]), match[2]
        elif below and is_paragraph(line):
            level, text = 1 if below[1][0] == '=' else 2, line.strip()
        else:
            continue
        base = slug = anchor(text)
        while slug in taken:
            taken[base] += 1
            slug = f'{base}-{taken[base]}'
        taken[slug] = 0
        headings.append(Heading(index + 1, level, text, slug))
    return headings


def toc_section(headings: list[Heading], count: int) -> tuple[int, int] | None:
    """0-based index of the '# Table of Contents' line, index of the next H1 or count (the
    number of lines)."""
    top = [h for h in headings if h.level == 1]
    for position, heading in enumerate(top):
        if heading.text == TOC_TITLE:
            end = top[position + 1].line - 1 if position + 1 < len(top) else count
            return heading.line - 1, end
    return None


def toc_lines(lines: list[str], section: tuple[int, int]) -> list[TocLine]:
    """The TOC item lines of the section, outside fenced code.

    A line holds items when it starts with `- [label](target)` after space indentation. A
    line that looks like a list item or starts with a tab but does not is unparsable: its
    indent is None, and its first `[label](target)` link, if any, stands in as its item.
    """
    start, end = section
    found = []
    for index, line in outside_fences(lines):
        if not start < index < end:
            continue
        indent = len(line) - len(line.lstrip(' '))
        if TOC_ITEM.match(line, indent):
            found.append(TocLine(index + 1, indent, list(TOC_ITEM.finditer(line))))
        elif line.strip() and TOC_LIKE.match(line):
            link = ITEM_LINK.search(line)
            found.append(TocLine(index + 1, None, [link] if link else []))
    return found


def check_headings(lines: list[str], headings: list[Heading]) -> list[tuple[int, str]]:
    """Headings whose anchor this script cannot compute."""
    return [
        (h.line, f"heading '{h.text}' contains markup whose anchor is not modeled;"
                 ' check it by hand')
        for h in headings
        if MARKUP.search(h.text)
    ] + [
        (index + 1, 'heading inside a list or quote is not modeled; check it by hand')
        for index, line in outside_code(lines)
        if NESTED_HEADING.match(line)
    ]


def toc_entries(
    lines: list[str], section: tuple[int, int]
) -> tuple[list[TocEntry], list[tuple[int, str]]]:
    """One entry per TOC item, first occurrences only, and the problems of the TOC lines."""
    entries, problems = [], []
    first = {}  # slug: line of its first entry
    for toc in toc_lines(lines, section):
        if toc.indent is None:
            problems.append((toc.line, UNPARSABLE))
        if len(toc.items) > 1:
            problems.append(
                (toc.line, f'TOC line holds {len(toc.items)} entries; put each on its own line')
            )
        for position, target in enumerate(item[1] for item in toc.items):
            if not target.startswith('#'):
                problems.append(
                    (toc.line, f"TOC entry links to '{target}'; TOC links must start with '#'")
                )
            slug = target.removeprefix('#')
            if slug in first:
                problems.append(
                    (toc.line, f'TOC entry #{slug} is listed twice (first at line {first[slug]})')
                )
                continue
            first[slug] = toc.line
            entries.append(TocEntry(toc.line, toc.indent if position == 0 else None, slug))
    return entries, problems


def check_toc(
    lines: list[str], headings: list[Heading], section: tuple[int, int]
) -> list[tuple[int, str]]:
    """Compare the TOC, in order and indentation, with the headings after its section, and
    report a heading after it that skips a level."""
    entries, problems = toc_entries(lines, section)
    # h.line is 1-based and section[1] is the 0-based index of the next H1, so `>` keeps
    # that H1 (its line is section[1] + 1) and every heading after it.
    body = [h for h in headings if h.line > section[1]]

    skips = set()  # headings that skip a level; their TOC indentation is not checked
    for previous, heading in zip(body, body[1:]):
        if heading.level > previous.level + 1:
            skips.add(heading)
            problems.append(
                (heading.line, f"heading '{heading.text}' skips from H{previous.level}"
                               f' to H{heading.level}')
            )

    matcher = difflib.SequenceMatcher(
        None, [entry.slug for entry in entries], [h.anchor for h in body], autojunk=False
    )
    stray, unlisted, facing = [], [], []
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag != 'equal':
            stray += entries[i1:i2]
            unlisted += body[j1:j2]
            if tag == 'replace' and i2 - i1 == j2 - j1:
                facing += zip(entries[i1:i2], body[j1:j2])
            continue
        for entry, heading in zip(entries[i1:i2], body[j1:j2]):
            expected = 4 * (heading.level - 1)
            if entry.indent is not None and entry.indent != expected and heading not in skips:
                problems.append(
                    (entry.line, f'TOC entry #{entry.slug} is indented {entry.indent} spaces, '
                                 f'expected {expected} (H{heading.level})')
                )

    # An anchor left over on both sides is listed, just not where its heading is.
    moved = {entry.slug for entry in stray} & {h.anchor for h in unlisted}
    # An entry and a heading facing each other in a replace block of equal length, neither
    # listed elsewhere, are one stale anchor.
    stale = [(e, h) for e, h in facing if e.slug not in moved and h.anchor not in moved]
    for entry, heading in stale:
        problems.append(
            (entry.line, f"TOC entry #{entry.slug} does not match heading '{heading.text}'"
                         f' (#{heading.anchor}, line {heading.line})')
        )
    stale_entries = {entry for entry, _ in stale}
    stale_headings = {heading for _, heading in stale}
    for heading in unlisted:
        if heading.anchor not in moved and heading not in stale_headings:
            problems.append(
                (heading.line, f"heading '{heading.text}' (#{heading.anchor}) has no TOC entry")
            )
    for entry in stray:
        if entry.slug in moved:
            problems.append((entry.line, f'TOC entry #{entry.slug} is out of order'))
        elif entry not in stale_entries:
            problems.append((entry.line, f'TOC entry #{entry.slug} matches no heading'))
    return problems


def blank(text: str, start: int, end: int) -> str:
    """text with text[start:end] replaced by spaces, so later offsets stay valid."""
    return text[:start] + ' ' * (end - start) + text[end:]


def blank_code_spans(text: str) -> str:
    """text with its code spans blanked out.

    As in GFM, backtick runs pair left to right with the next run of the same length, and a
    run without a partner is literal.
    """
    runs = list(BACKTICKS.finditer(text))
    position = 0
    while position < len(runs):
        opening = runs[position]
        closing = next(
            (k for k in range(position + 1, len(runs)) if len(runs[k][0]) == len(opening[0])),
            None,
        )
        if closing is None:
            position += 1
            continue
        text = blank(text, opening.start(), runs[closing].end())
        position = closing + 1
    return text


def link_targets(text: str) -> list[str]:
    """Targets of the inline links, reference definition and `href` or `src` attributes on a
    line, in order, outside code spans."""
    text = blank_code_spans(text)
    found = [(match.start(), match[1]) for match in LINK.finditer(text)]
    found += [(match.start(), match[2]) for match in ATTRIBUTE.finditer(text)]
    found += [(match.start(), match[1]) for match in REFERENCE.finditer(text)]
    return [target for _, target in sorted(found)]


def link_problem(target: str, anchors: set[str], base_dir: Path) -> str | None:
    """Why a link target fails on GitHub, or None when it resolves or is external."""
    if SCHEME.match(target):
        return None
    if target == '#':
        return "empty in-page link '#'; name a heading anchor"
    if target.startswith('#'):
        return None if target[1:] in anchors else f'link to {target} matches no heading'
    if target.startswith(BRANCH_LINK):
        return f"relative branch link '{target}' 404s on GitHub; use {REPO_URL}{target}"
    path = unquote(target.partition('?')[0].partition('#')[0])
    # The repository is the README's directory, and a leading `/` names its root, as on
    # GitHub. normpath works on the text, so unlike Path.resolve() it keeps a symlinked
    # checkout or folder inside the repository.
    relative = os.path.normpath(path.removeprefix('/'))
    if os.path.isabs(relative) or relative.split(os.sep)[0] == os.pardir:
        return f"link target '{target}' points outside the repository"
    if not (base_dir / relative).exists():
        return f"link target '{target}' does not exist"
    return None


def check_links(
    lines: list[str], headings: list[Heading], section: tuple[int, int], base_dir: Path
) -> list[tuple[int, str]]:
    """In-page, repo file and release branch links outside code and the TOC items."""
    anchors = {h.anchor for h in headings}
    # check_toc reports the TOC items' targets; any other link on their lines is checked here.
    toc_items = {toc.line: toc.items for toc in toc_lines(lines, section)}
    problems = []
    for index, line in outside_code(lines):
        for item in toc_items.get(index + 1, ()):
            line = blank(line, item.start(), item.end())
        for target in link_targets(line):
            if problem := link_problem(target, anchors, base_dir):
                problems.append((index + 1, problem))
    return problems


def escape_data(text: str) -> str:
    """Text escaped for the message of a GitHub workflow command."""
    return text.replace('%', '%25').replace('\r', '%0D').replace('\n', '%0A')


def escape_property(text: str) -> str:
    """Text escaped for a property value (`file=`) of a GitHub workflow command."""
    return escape_data(text).replace(':', '%3A').replace(',', '%2C')


def report(path: str, problems: list[tuple[int, str]], github: bool) -> None:
    """Print the problems sorted by line, plain or as GitHub error annotations."""
    for line, message in sorted(problems, key=lambda problem: problem[0]):
        if github:
            print(f'::error file={escape_property(path)},line={line}::{escape_data(message)}')
        else:
            print(f'{path}:{line}: {message}')


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=DESCRIPTION)
    parser.add_argument(
        'path', nargs='?', help='README to check (default: README.md at the repository root)'
    )
    args = parser.parse_args(argv)
    if args.path is None:
        path, shown = Path(__file__).resolve().parent.parent / 'README.md', 'README.md'
    else:
        path, shown = Path(args.path), args.path

    try:
        lines = path.read_text(encoding='utf-8-sig').splitlines()
    except (OSError, UnicodeDecodeError) as exc:
        reason = exc.strerror if isinstance(exc, OSError) and exc.strerror else exc
        print(f'{shown}: cannot read ({reason})', file=sys.stderr)
        return 2
    headings = parse_headings(lines)
    section = toc_section(headings, len(lines))
    if section is None:
        print(f"{shown}: no '# {TOC_TITLE}' section", file=sys.stderr)
        return 2

    problems = (
        check_headings(lines, headings)
        + check_toc(lines, headings, section)
        + check_links(lines, headings, section, path.parent)
    )
    report(shown, problems, os.environ.get('GITHUB_ACTIONS') == 'true')
    return 1 if problems else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
